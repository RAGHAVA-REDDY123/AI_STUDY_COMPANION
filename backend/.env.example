# Backend Configuration
PROJECT_NAME="AI Study Companion"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_study_companion
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion

# Redis Configuration (Queue & Locks)
REDIS_URL=redis://localhost:6379/0

# AI Provider (Gemini 2.5 Flash + BGE-small 384-dim Embeddings)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT=45.0
AI_COST_TRACKING_ENABLED=true
AI_LOGGING_ENABLED=true
AI_EVALUATION_ENABLED=true
PROMPT_VERSION_TUTOR=tutor_v1.0
PROMPT_VERSION_QUIZ=quiz_gen_v2.0
PROMPT_VERSION_EVAL=assessment_rubric_v1.0
RETRIEVAL_VERSION=hybrid_rrf_v1.0_bge384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Storage
STORAGE_DIR=storage/uploads

# Initial Admin Credentials (for seed migration)
FIRST_SUPERUSER_EMAIL=admin@aiprof.com
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
