# ==============================================================================
# AI STUDY COMPANION - PRODUCTION DOCKER COMPOSE CONFIGURATION
# ==============================================================================

# Database Settings (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=ai_study_companion
POSTGRES_PORT=5432

# Redis Settings
REDIS_PORT=6379

# Backend Settings
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=production

# AI Provider Settings (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_COST_TRACKING_ENABLED=true
AI_LOGGING_ENABLED=true

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# Seed Administrator Credentials
FIRST_SUPERUSER_EMAIL=admin@aiprof.com
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
